    {"componentId":"codex-versioned-command-runner","agentId":"chatgpt","role":"versionedHelper","nameRegex":"(?i)^codex-command-runner-[0-9A-Za-z._-]+\\.exe$","signaturePolicy":"ValidOrPinnedHash","trustedRootTemplates":["%USERPROFILE%\\.cache\\codex-runtimes","%LOCALAPPDATA%\\OpenAI\\Codex"]},
    {"componentId":"codex-pwsh-bridge","agentId":"chatgpt","role":"bridgeShell","nameRegex":"(?i)^pwsh\\.exe$","signaturePolicy":"ValidOrPinnedHash","trustedRootTemplates":["%USERPROFILE%\\.cache\\codex-runtimes"]}
