    {"agentId":"claude","productName":"Claude","displayNameRegex":"(?i)Claude","packageNameRegex":"(?i)Claude","executableNames":["Claude.exe"],"knownPathTemplates":["%LOCALAPPDATA%\\Programs\\Claude\\Claude.exe","%PROGRAMFILES%\\Claude\\Claude.exe","%PROGRAMFILES(X86)%\\Claude\\Claude.exe"]},
    {"agentId":"cursor","productName":"Cursor","displayNameRegex":"(?i)Cursor","packageNameRegex":"(?i)Cursor","executableNames":["Cursor.exe"],"knownPathTemplates":["%LOCALAPPDATA%\\Programs\\cursor\\Cursor.exe","%LOCALAPPDATA%\\Programs\\Cursor\\Cursor.exe","%PROGRAMFILES%\\Cursor\\Cursor.exe","%PROGRAMFILES(X86)%\\Cursor\\Cursor.exe"]},
    {"agentId":"windsurf","productName":"Windsurf","displayNameRegex":"(?i)Windsurf","packageNameRegex":"(?i)Windsurf","executableNames":["Windsurf.exe"],"knownPathTemplates":["%LOCALAPPDATA%\\Programs\\Windsurf\\Windsurf.exe","%PROGRAMFILES%\\Windsurf\\Windsurf.exe","%PROGRAMFILES(X86)%\\Windsurf\\Windsurf.exe"]}
